OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MONGO_URI=
MONGO_DB_NAME=tribunal
CORS_ORIGINS=http://localhost:3000
# Both model pools are always configured; the user picks "same" or
# "distinct" per trial via the request body (no restart needed to switch).
# Free-tier OpenRouter picks as of 2026-08; judges need response_format
# json_object support. Re-check openrouter.ai/models — free-tier lineup churns.
SAME_MODEL=openai/gpt-oss-20b:free

PROSECUTOR_1_MODEL=poolside/laguna-xs-2.1:free
PROSECUTOR_2_MODEL=poolside/laguna-s-2.1:free
DEFENDER_1_MODEL=cohere/north-mini-code:free
DEFENDER_2_MODEL=google/gemma-4-26b-a4b-it:free
JUDGE_1_MODEL=openai/gpt-oss-20b:free
JUDGE_2_MODEL=openai/gpt-oss-20b:free
JUDGE_3_MODEL=dots-studio/dots-3-note-preview:free

LAWYER_MAX_TOKENS=800
REQUEST_TIMEOUT_SECONDS=30.0
